# BusTracker Server
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://bustracker:bustracker@db:5432/bustracker

# Redis
REDIS_URL=redis://redis:6379/0

# UTIC API (https://www.utic.go.kr 에서 발급)
UTIC_API_KEY=your_utic_api_key_here
UTIC_BASE_URL=http://www.utic.go.kr

# ITS API (https://www.its.go.kr 에서 발급)
ITS_API_KEY=your_its_api_key_here

# YOLO
YOLO_MODEL_PATH=yolov8n.onnx
YOLO_CONFIDENCE_THRESHOLD=0.4

# Polling
SNAPSHOT_INTERVAL_SECONDS=7
MAX_CONCURRENT_STREAMS=3

# Location
DEFAULT_BUS_SPEED_KMH=40.0
